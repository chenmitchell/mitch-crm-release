{
  "name": "@mitchcrm/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mitch CRM backend — NestJS 10 + Prisma。反向代理轉進來,預設監聽 :8787(PORT 可改)",
  "license": "MPL-2.0",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "lint": "node ../../scripts/lint/run-eslint-node.mjs \"{src,test}/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo node_modules/.cache",
    "prisma:generate": "prisma generate",
    "migrate:dev": "echo '這個 repo 沒有 prisma/migrations/,建表走 prisma db push,不是 prisma migrate。請改用 pnpm --filter ./apps/backend run prisma:push;容器部署由 deploy/backend-entrypoint.sh 自動做掉,不必手動下。' >&2 && exit 1",
    "migrate:deploy": "echo '這個 repo 沒有 prisma/migrations/,建表走 prisma db push,不是 prisma migrate。請改用 pnpm --filter ./apps/backend run prisma:push;容器部署由 deploy/backend-entrypoint.sh 自動做掉,不必手動下。' >&2 && exit 1",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:attribution": "tsx scripts/seed-attribution.ts",
    "prisma:push": "prisma db push --skip-generate"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@mitchcrm/shared": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
