# ref:3687 mc/陳彥輔/米球®
# =====================================
# Mitch CRM Backend — .env.example
# =====================================
# 本機開發:複製成 .env(或 .env.local)。
# 正式環境:把同樣這些值設成部署平台的環境變數,不要把 .env 放進映像檔。
# 走 Docker Compose 部署的話不用管這一份,改看 repo 根目錄的 .env.example。
# 重要:Secrets 絕對不入 repo(已進 .gitignore)

# ---- Server ----
# 內部 PORT。預設 8787。
# 要換成別的值就改這個環境變數,程式不用動,反向代理記得跟著改。
PORT=8787
# 重要:正式部署一定要改成 production。這一份留 development 是因為它的第一順位讀者
#    是在自己機器上開發的人,不是因為 development 適合上線。
#    NODE_ENV 不只是個標籤,它至少決定兩件事:
#      1. 下面 COOKIE_SECURE 留空時,session cookie 要不要帶 Secure 旗標
#         (留空 = 只有 production 才帶)
#      2. NestJS 與相依套件自己的 production 行為(例如錯誤細節不外露)
#    忘了改不會讓系統起不來,也不會有錯誤 log,所以請現在就改。
NODE_ENV=development
# 重要:這個值有三個用途,不是只有 CORS:
#    1. CORS allowlist(允許哪個前端網址呼叫這支 API)
#    2. CSRF 的來源白名單:POST / PATCH / DELETE 只要帶了不在這份清單裡的 Origin
#       就一律 403。所以它必須等於使用者瀏覽器實際打的那個網址,
#       從區網 IP 進站卻沒改這個值的話,連登入都會 403,而且後端沒有明顯錯誤 log。
#    3. 對外網址。後台產生的邀請連結與單一登入導回的位址都用它的第一段。
#       系統不會替你把連結寄出去(後端沒有任何寄信實作),連結是複製下來自己傳給對方的,
#       但值填錯的話複製到的就是錯的網址,對方點不開,而後端不會有任何錯誤 log。
#    請填使用者在瀏覽器實際打的那個對外網址(前後端同網址時就填同一個)。
#    多個 origin 用逗號分隔,第一個會被當成對外網址。
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
# PostgreSQL 16。密碼含 @ : / ? # 等字元要做 URL 編碼,否則會被解析成別的主機。
DATABASE_URL=postgresql://mitchcrm:mitchcrm@localhost:5432/mitchcrm?schema=public

# ---- JWT ----
# 重要:[必填]沒填或長度不足 32 字元,後端啟動時 env 驗證就會擋下來,訊息是
#    「JWT_ACCESS_SECRET must be >= 32 chars」。下面這個佔位值是合法長度的假值,
#    照樣起得來,但**上線前一定要換掉**。
# 生成指令:openssl rand -base64 48
# 只有一把金鑰:沒有更新權杖,續期靠滑動續期(效期過半的請求會重簽一份)。
JWT_ACCESS_SECRET=CHANGE-ME-dev-only-not-a-real-secret-0000000000
JWT_ACCESS_TTL=8h

# ---- Argon2id 登入失敗鎖定 ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# ---- 初始管理員(命令列 seed 用;走首次啟動精靈的話不必填)----
SEED_ADMIN_EMAIL=admin@example.com
# 指定初始管理員密碼,至少 12 個字元(跟精靈、邀請註冊、改密碼同一組規則)。
# ★ 留空 = 不建任何帳號。seed:admin 會印一行「沒有設 SEED_ADMIN_PASSWORD,所以不建立帳號」
#   就結束,請改用瀏覽器打開前端的 /setup 走首次啟動精靈。以前那個「留空就產一組隨機密碼
#   印在 log」的行為已經拿掉了:它會讓資料庫一開機就有帳號,精靈因此永遠不出現。
# 填太短(1 到 11 個字元)的話,env 驗證會在開機當下就 exit(1) 並印出原因。
# 用完請把這一項清掉,它沒有 runtime 用途。
SEED_ADMIN_PASSWORD=

# ---- 觀測 ----
# logger 等級照 NODE_ENV 決定,沒有對外開關,所以這裡沒有 LOG_LEVEL。

# 錯誤記錄(error_logs)的保留期與同訊息合併
# 超過這個天數的整列刪掉(1 到 365)
ERROR_LOG_RETENTION_DAYS=30
# 同一個指紋在這段時間內只累加次數不新增列(1 到 1440)
ERROR_LOG_DEDUPE_WINDOW_MINUTES=60

# 稽核記錄(audit_logs)的保留期,超過這個天數的整列刪掉(分批刪,不鎖整張表)
# 只接受 0 或 90 到 3650。0 = 永不刪除。預設 730 天,理由見 src/common/env.ts
AUDIT_LOG_RETENTION_DAYS=730

# ---- 地圖服務(選用)----
# 地理編碼走 OpenStreetMap Nominatim,對方的使用政策要求 User-Agent 帶得出聯絡方式。
# 這一項也可以在後台的系統設定填(那一份優先),兩邊都沒填就會送 placeholder,
# 對方有可能因此擋掉請求,現象是「地址查不到座標」而不是明顯的錯誤。
# 自架 Nominatim 或改用相容服務時,基底網址填在後台系統設定的 geocoderBaseUrl。
NOMINATIM_EMAIL=

# ---- Rate limiting(@nestjs/throttler) ----
# 時間窗長度(秒),兩組限制共用
THROTTLE_TTL_SECONDS=60
# 一般端點上限。後台一個畫面就會連打十幾支 API,抓太緊會誤傷正常操作
THROTTLE_LIMIT_DEFAULT=100
# 憑證類端點上限:/auth/login、邀請連結、首次啟動精靈
THROTTLE_LIMIT_STRICT=10
# 重要:取得真實客戶端 IP 用的 Express trust proxy hop 數,一定要跟實際 proxy 層數一致
#    只有一層反向代理(例如 repo 根目錄那份 docker-compose.yml)請填 1
#    前面再加 CDN 或公司的負載平衡器,每多一層就加 1
#    本機直連(沒有任何 proxy)請填 0
#    填太小 = 全部請求被算成同一個 IP,一個人打滿全站 429
#    填太大 = X-Forwarded-For 可被偽造,rate limit 形同虛設
#    另外最外層的代理必須設定成只接受上游來源(或自行覆寫 X-Forwarded-For)
TRUST_PROXY_HOPS=1

# ─────────────────────────────────────────────────────────────
# Microsoft Entra ID 單一登入(選用)
# 四個值全部填好才會啟用;留空 = 登入頁只有帳號密碼,行為跟沒設一樣
# ─────────────────────────────────────────────────────────────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# 必須跟 Entra 應用程式註冊裡填的「重新導向 URI」一字不差
# 例:https://crm.example.com/api/auth/entra/callback
ENTRA_REDIRECT_URI=
# 只允許這些網域(逗號分隔);留空 = 不限網域,但帳號仍必須先存在於 users 表
ENTRA_ALLOWED_DOMAINS=
# true = 目錄有這個人就自動開後台帳號。預設 false,由管理員手動建立
ENTRA_AUTO_PROVISION=false
# 登入成功後導回前端的網址(留空則用 CORS_ORIGIN 的第一個)
ENTRA_POST_LOGIN_URL=

# ─────────────────────────────────────────────────────────────
# 其餘可選設定
# ─────────────────────────────────────────────────────────────
# session cookie 的 Secure 旗標。留空 = 依 NODE_ENV 判斷(production 才帶)。
# 純 http 試跑時必須填 false,否則瀏覽器會丟掉 cookie,
# 現象是「登入成功卻立刻被踢回登入頁」,而且 log 上完全正常。
#
# 重要:走 https 就填 true,不要靠留空加 NODE_ENV 去撐。
#    留空而且 NODE_ENV 忘了改成 production 的話,結果是 false:
#    服務放在 https 後面照樣正常跑,cookie 卻少了 Secure 旗標,
#    而這件事在畫面上、log 上都看不出來。
#    後端會從 CORS_ORIGIN 是不是 https 開頭判斷這個情況,命中時在啟動 log 印一則 warn,
#    但那是最後一道保險,不是設定方式。
COOKIE_SECURE=
