# ref:3687 mc/陳彥輔/米球®
# =============================================================
# Mitch CRM — 自架部署用環境變數
# =============================================================
# 這份檔案在 repo 裡,.env 不在(已列入 .gitignore)。
#
# 最快的起手式:什麼都不用做。
#   docker compose up -d
# 沒有 .env 也跑得起來,缺的金鑰由 backend 第一次啟動時自動產生,
# 寫進 app-secrets 這顆 volume。
#
# 要自己指定就複製一份再填:
#   cp .env.example .env
#   bash scripts/setup.sh     # 或用這支自動產生金鑰
#
# 標記說明:
#   [必填] 沒填就起不來
#   [選填] 不填就用預設值,或關閉該功能
#   [建議] 不填也能跑,但正式環境應該要填
# =============================================================

# -------------------------------------------------------------
# 對外網址與連接埠
# -------------------------------------------------------------
# [選填] 使用者在瀏覽器打的網址。預設 http://localhost:8080。
#        這一個值同時餵給三個地方:
#          前端 build 的 NEXT_PUBLIC_API_BASE_URL 與 NEXT_PUBLIC_SITE_URL
#          後端的 CORS_ORIGIN
#        後端的 CORS_ORIGIN 除了 CORS 之外還有兩個身分:CSRF 的來源白名單
#        (會改狀態的請求帶了不在清單裡的 Origin 一律 403),以及後台產生的
#        邀請連結與單一登入導回位址的網址前綴。系統不會替你把連結寄出去
#        (後端沒有任何寄信實作),連結是複製下來自己傳給對方的,但這個值填錯的話
#        複製到的就是錯的網址,對方點不開,而且後端不會有任何錯誤 log。
#
#        前端是 build 時把這個值編進 bundle 的,改了要重新建置才生效:
#          docker compose up -d --build
PUBLIC_BASE_URL=http://localhost:8080

# [選填] 反向代理在容器內監聽的位址。
#          :80              純 HTTP,適合本機或前面已經有 LB / WAF
#          crm.example.com  Caddy 自動申請 Let's Encrypt 憑證,
#                           此時 APP_PORT 要設 80、APP_HTTPS_PORT 要設 443,
#                           而且該網域的 DNS 必須已經指到這台機器
SITE_ADDRESS=:80

# [選填] host 上要開的連接埠。這是整套系統唯一對外的埠。
#        內網部署常見改成 80 / 443。
APP_PORT=8080
APP_HTTPS_PORT=8443

# [選填] 後端在容器內監聽的連接埠,不對外開放。
#        改這個值不必改別的地方,反向代理跟著同一個變數走。
BACKEND_PORT=8787

# [選填] 前端頁尾的環境標記。production 以外的值會在每一頁頁尾顯示環境名稱,
#        用來避免把測試站當成正式站操作。build 時編進 bundle,改了要重新建置。
NEXT_PUBLIC_APP_ENV=production

# [選填] 前端建置時 next/font/google 會去 fonts.googleapis.com 與
#        fonts.gstatic.com 抓 Noto Sans TC 的字型檔自架。建置機器連不到
#        那兩個網域的話,next build 會直接失敗(症狀出現在 docker compose
#        up -d --build 的 frontend 那一段)。離線或受限網路的環境設成
#        /src/scripts/build/next-font-google-mock.cjs 改用離線替身,
#        畫面會退回系統字型,版面與功能不受影響。
#        有網路的機器留空即可。
# NEXT_FONT_GOOGLE_MOCKED_RESPONSES=

# -------------------------------------------------------------
# 資料庫
# -------------------------------------------------------------
# [選填] 要改接既有的 PostgreSQL 就在這裡設整串連線字串,
#        並且每次 compose 指令都多帶一份疊加檔:
#          docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d --build
#        設了這一項之後,下面的 POSTGRES_* 就不會被用到。
#        密碼含 @ : / ? # 等字元要先做 URL 編碼。
# DATABASE_URL=postgresql://帳號:密碼@資料庫主機:5432/資料庫?schema=public

# [選填] compose 內建那台資料庫的名稱與帳號
POSTGRES_DB=mitchcrm
POSTGRES_USER=mitchcrm

# [建議] 資料庫密碼。留空會用預設值 mitchcrm。
#        這台資料庫不對 host 開埠,只有 compose 內網連得到,
#        但正式環境仍請自己指定一組。
#        自己填的話請只用英數字:這個值會被組進 DATABASE_URL,
#        含 @ : / ? # 等字元要另外做 URL 編碼,很容易踩到。
#        產生指令:openssl rand -hex 24
#
#        ★ 這個值只在資料庫「第一次」啟動、資料目錄還是空的時候生效。
#        postgres 官方映像只有在初始化空的資料目錄時才會拿它建帳號密碼,
#        之後每次啟動都只是掛上既有的 postgres-data volume,密碼沿用舊的。
#        所以「先 docker compose up -d 跑起來,之後才回頭填這一格」的順序會壞:
#        DATABASE_URL 換成新密碼、資料庫裡還是舊密碼,backend log 會出現
#        password authentication failed for user "mitchcrm",/readyz 回 503,
#        畫面打得開但每一支 API 都失敗。
#        要在事後換密碼,兩條路擇一:
#          (a) 進資料庫自己改:
#              docker compose exec postgres psql -U mitchcrm -d mitchcrm \
#                -c "ALTER USER mitchcrm WITH PASSWORD '新密碼';"
#              然後把同一個值填進這一格,再 docker compose up -d
#          (b) 資料還可以丟的話,整組砍掉重來(會刪光資料庫內容,想清楚再做):
#              docker compose down -v
#        最省事的做法是**第一次 up 之前**就把這一格填好。
POSTGRES_PASSWORD=

# [選填] 資料表由 backend 啟動時自動建立(prisma db push)。
#        資料庫由 DBA 管控、不允許應用程式自己建表的環境設成 true,
#        改由 DBA 依 apps/backend/prisma/schema.prisma 建表。
# MITCHCRM_SKIP_DB_PUSH=false

# -------------------------------------------------------------
# 金鑰(一把)
# -------------------------------------------------------------
# 留空 = backend 第一次啟動時自動產生,存進 app-secrets 這顆 volume,
# 重啟後沿用同一組。零設定啟動就是靠這個機制。
#
# 正式環境建議自己指定並離線備份,理由有兩個:
#   1. 刪掉 volume 等同刪掉金鑰。
#   2. 要換機器或做災難復原時,沒有金鑰就還原不了。

# [建議] JWT 簽章金鑰,至少 32 字元。
#        產生指令:openssl rand -hex 48
#        只有一把:登入權杖是這套系統唯一的權杖,沒有更新權杖(refresh token),
#        還在用的人靠滑動續期留著(效期過半的請求會重簽一份)。
JWT_ACCESS_SECRET=

# -------------------------------------------------------------
# 初始管理員
# -------------------------------------------------------------
# 建管理員有兩種方式,擇一:
#   (a) 首次啟動精靈(預設,建議):下面兩格照原樣留著就好,起站後用瀏覽器打開
#       前端的 /setup,當場輸入信箱與密碼。密碼不會出現在任何環境變數或 log 裡。
#   (b) 環境變數(自動化部署用):兩格都填。後端啟動時如果發現資料庫裡一個使用者
#       都沒有,就用這一組建立第一個管理員,並標記「下次登入必須改密碼」。
# 資料庫裡只要有任何使用者,兩種方式都完全不動作,不會覆寫既有帳號。
#
# [選填] 自動建立管理員時要用的信箱。走精靈的話這個值用不到,留空即可。
#        env 驗證把它當選填:沒填照樣起得來(走精靈);填了的話要是合法信箱格式。
SEED_ADMIN_EMAIL=

# [選填] 自動建立管理員時要用的密碼,至少 12 個字元。
#        ★ 留空 = 不自動建帳號,請走 /setup 精靈。不會再自己產隨機密碼 ——
#          以前那個行為會讓資料庫一開機就有帳號,精靈因此永遠不出現。
#        填了的話跑完建議把這一格清空:它已經沒有 runtime 用途,
#        而值會留在部署平台的設定畫面與部署紀錄裡。
SEED_ADMIN_PASSWORD=

# -------------------------------------------------------------
# 其他後端設定(多數情況不用動)
# -------------------------------------------------------------
# [選填] Express trust proxy 的層數,決定速率限制認到的來源 IP。
#        照本 compose 部署 = 只有 Caddy 一層 = 1。
#        前面再加 LB 或 CDN,每多一層就加 1。
#        設太小:全部請求被算成同一個 IP,一個人打滿全站被擋。
#        設太大:X-Forwarded-For 可被偽造,速率限制形同虛設。
TRUST_PROXY_HOPS=1

# [選填] session cookie 要不要帶 Secure 旗標。
#        走 https 一定要 true;純 http 試跑必須 false,
#        否則瀏覽器會丟掉 cookie,症狀是登入成功卻馬上被踢回登入頁。
COOKIE_SECURE=false

# [選填] session cookie 的 SameSite 屬性:lax(預設)/ strict / none。
#        前後端同一個網域(本 compose 的部署就是)維持 lax 即可。
#
#        什麼時候要改成 none:**前端與後端各自一個網域**的部署,
#        例如 PaaS 上前端 app.example.com、後端 api.example.com。
#        那種情況下瀏覽器把登入請求視為跨站,SameSite=Lax 的 cookie 根本不會送出去,
#        症狀是「登入回應 200,下一個請求就變成未登入」,而且後端 log 完全正常,
#        從伺服器這一側看不出任何異常。
#
#        設成 none 的話一定要同時走 https 並且 COOKIE_SECURE=true
#        (瀏覽器規定 None 必須配 Secure,不配就直接丟掉 cookie)。
#        後端會自動補上 Secure,並在啟動 log 喊一聲提醒。
#        另外 CORS_ORIGIN 要填前端那個網域,否則瀏覽器連請求都不會發出。
#
#        **改成 none 等於關掉一道 CSRF 防線,請先讀完這一段。**
#        SameSite=Lax 的作用不只是「cookie 送不送得出去」,它同時擋住了跨站偽造請求:
#        別的網站放一個表單騙已登入的人按下去,cookie 不會被帶上,所以請求不成立。
#        改成 none 之後這道就沒了,而這套系統沒有 CSRF token,也沒有 double-submit cookie。
#        目前剩下的防線有兩道:
#          1. Origin 檢查(後端全域守衛):會改狀態的請求(POST / PATCH / DELETE)
#             如果帶了 Origin 而且不在 CORS_ORIGIN 允許清單裡,一律 403
#          2. Content-Type:前端一律送 application/json,那會觸發 CORS 預檢
#        擋不到的是「同一個網域下另一個被入侵的應用」發出的請求 —— 它的 Origin 是合法的。
#        所以最穩的做法仍然是**前後端同一個網址**部署(本 compose 的預設),
#        讓 COOKIE_SAMESITE 維持 lax。細節見 SECURITY.md。
COOKIE_SAMESITE=lax

# [選填] 登入失敗鎖定
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# [選填] 登入權杖有效期。預設 8 小時 = 一個工作天。
#        還在操作的人不會被踢出去:效期過半的請求會自動重簽一份(滑動續期),
#        所以這個值是「離開多久之後要重新登入」,不是「用多久之後被登出」。
JWT_ACCESS_TTL=8h

# [選填] 錯誤記錄的保留期與同訊息合併。
#        ERROR_LOG_RETENTION_DAYS:超過這個天數的整列刪掉(1 到 365,預設 30)。
#        ERROR_LOG_DEDUPE_WINDOW_MINUTES:同一個指紋在這段時間內只累加次數不新增列
#        (1 到 1440,預設 60)。這張表存的是 message 與 stack,不設上限會無限長大。
ERROR_LOG_RETENTION_DAYS=30
ERROR_LOG_DEDUPE_WINDOW_MINUTES=60

# [選填] 稽核記錄(audit_logs)的保留期。超過這個天數的整列刪掉,分批刪不會鎖整張表。
#        預設 730 天(兩年):稽核記錄的價值在事後追查,而追查通常在事情發生很久之後
#        才開始(人離職了才對帳、稽核一年一次),設短的後果是要查的時候證據已經沒了。
#        只接受 0 或 90 以上(最大 3650):0 = 永不刪除,給有法遵保留義務的部署用;
#        下限 90 是為了不讓手滑填個 1 就把稽核軌跡清成三天份。
AUDIT_LOG_RETENTION_DAYS=730

# [選填] 速率限制。THROTTLE_LIMIT_STRICT 管的是登入這類猜得中就有機會進去的端點。
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_LIMIT_STRICT=10

# -------------------------------------------------------------
# 選用功能:拜訪地圖的地理編碼
# -------------------------------------------------------------
# [選填] 地址轉座標走 OpenStreetMap Nominatim,對方的使用條款要求 User-Agent 帶得出
#        一個聯絡信箱。這一格也可以在後台的「地圖與地理編碼」頁籤填,那一份優先,
#        後台留空時才退回讀這個變數。
#        兩邊都留空**不會關掉地理編碼**:請求照樣送出去,只是 User-Agent 帶的是
#        placeholder,對方有可能因此擋掉,現象是「地址一直查不到座標」而不是明顯的錯誤。
#        真的要關掉地理編碼,是在後台「地圖與地理編碼」把服務選成「不啟用」。
NOMINATIM_EMAIL=

# -------------------------------------------------------------
# 選用功能:Microsoft Entra ID 單一登入(SSO)
# -------------------------------------------------------------
# [選填] 全部留空 = 不啟用 SSO,只有帳號密碼登入,系統照常運作。
#
# 這四個憑證值只能從這裡來。後台的「單一登入設定」存的是政策
#(哪些網域可以登入、要不要自動建帳號、預設部門與主管),不存憑證:
# 憑證輪替是 IT 在部署平台改變數的事,而且那一列會被後台端點讀出來組回應,
# 密碼放進去等於多一條外洩路徑。
#
# 填完要重啟 backend 才會生效。四個值沒有全部填齊的話,登入頁不會出現
# Microsoft 按鈕(這是刻意的:半套設定會在使用者按下去之後才失敗)。
#
# 值從哪裡來:Entra 系統管理中心 → 應用程式註冊 → 你的應用程式 → 概觀。
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# 應用程式註冊 → 憑證及密碼 → 用戶端密碼。建立後只顯示一次,離開頁面就看不到。
ENTRA_CLIENT_SECRET=
# 必須與 Entra 應用程式註冊裡填的重新導向 URI 一字不差,結尾不要多斜線。
# 照本 compose 部署的話是 PUBLIC_BASE_URL 後面接 /api/auth/entra/callback。
ENTRA_REDIRECT_URI=

# [選填] 下面三個後台也能改,而且後台的值優先,這裡只是第一次上線的起始值。
# 允許登入的信箱網域,逗號分隔;留空 = 不限網域(租用戶內誰都能登入)。
ENTRA_ALLOWED_DOMAINS=
# 第一次用 SSO 登入、系統裡還沒有這個人時,要不要自動建帳號。
ENTRA_AUTO_PROVISION=false
# 登入成功後導去哪裡;留空 = 用系統預設的首頁。
ENTRA_POST_LOGIN_URL=

# 注意:這份檔案裡沒有寄信相關的變數。後端沒有任何寄信實作,
# 之前列在這裡的 RESEND_API_KEY / MAIL_FROM 填了不會寄出任何信,
# 也不在 env 驗證的 schema 裡。邀請連結請自己複製後用既有管道給對方。
